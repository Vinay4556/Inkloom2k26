# Copy to .env.local and adjust. Never commit real values.

# Local demo store (JSON file). Default: ./.data/inkloom.json
INKLOOM_DATA_FILE=

# Set to "true" to retain submitted content in review records.
# Default (unset/false): only a SHA-256 fingerprint, length, and findings are stored.
INKLOOM_RETAIN_CONTENT=false

# Reserved for a future PostgreSQL adapter (not wired in; see db/migrations/0000_init.sql)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/inkloom
