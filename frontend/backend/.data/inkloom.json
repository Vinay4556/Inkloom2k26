  "rules": [
    {
      "id": "rule_morrow-goods_absolute-environmental-claim",
      "brandId": "morrow-goods",
      "stableId": "absolute-environmental-claim",
      "name": "Absolute Environmental Claim",
      "type": "absolute-claim",
      "description": "Absolute environmental claims like '100% sustainable' or 'zero impact' are difficult to substantiate and may mislead consumers. Regulatory guidance (e.g., FTC Green Guides, UK CMA) recommends specific, qualified claims instead.",
      "severity": "error",
      "patterns": [
        "100% sustainable",
        "zero impact",
        "completely eco-friendly",
        "totally green",
        "fully carbon neutral",
        "100% biodegradable",
        "zero waste"
      ],
      "suggestion": "Replace with specific, measurable claims (e.g., 'made with 80% recycled materials' or 'reduces packaging waste by 40%').",
      "enabled": true,
      "version": 1,
      "createdAt": "2026-10-27T18:18:20.944Z",
      "updatedAt": "2026-10-27T18:18:20.944Z"
    },
    {
      "id": "rule_morrow-goods_restricted-phrases",
      "brandId": "morrow-goods",
      "stableId": "restricted-phrases",
      "name": "Restricted Phrases",
      "type": "restricted-phrase",
      "description": "Words like 'guaranteed', 'miracle', and 'risk-free' imply absolute certainty that rarely exists in practice. These trigger mandatory human review per Morrow Goods policy.",
      "severity": "error",
      "patterns": [
        "guaranteed",
        "miracle",
        "risk-free"
      ],
      "suggestion": "Use qualified language (e.g., 'designed to reduce risk', 'clinically tested', 'backed by our warranty').",
      "enabled": true,
      "version": 1,
      "createdAt": "2026-10-27T18:18:20.944Z",
      "updatedAt": "2026-10-27T18:18:20.944Z"
    },
    {
      "id": "rule_morrow-goods_vague-superlatives",
      "brandId": "morrow-goods",
      "stableId": "vague-superlatives",
      "name": "Vague Superlatives",
      "type": "vague-superlative",
      "description": "Vague superlatives cannot be verified and may appear as puffery. Morrow Goods tone prefers specific, grounded language.",
      "severity": "warning",
      "patterns": [
        "best in class",
        "world-class",
        "unparalleled",
        "unmatched",
        "revolutionary",
        "game-changing",
        "unbeatable"
      ],
      "suggestion": "Replace with concrete differentiators (e.g., 'rated 4.8/5 by 2,000+ customers', 'uses 30% less energy than standard models').",
      "enabled": true,
      "version": 1,
      "createdAt": "2026-10-27T18:18:20.944Z",
      "updatedAt": "2026-10-27T18:18:20.944Z"
    }
  ],
